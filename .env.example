# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ielts

# JWT — use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allowed frontend origins (required when NODE_ENV=production)
CORS_ORIGINS=http://localhost:3000
# Production example:
# CORS_ORIGINS=https://learnix.tw1.ru,https://www.learnix.tw1.ru

# Trust X-Forwarded-* from nginx (default: 1 in production, 0 in dev). Set false to disable.
# TRUST_PROXY=1

# Set to true to allow POST /auth/register in production (default: disabled)
ALLOW_PUBLIC_REGISTRATION=false

# Seed: bootstrap super-admin created by `npm run seed` (weak passwords blocked in production)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=change_me_super_admin_password

# Telegram bot token from @BotFather (parent notifications)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL — registered with Telegram via setWebhook on server start.
# Path must match the Express route (/api/telegram/webhook). Dev: use ngrok/cloudflared.
TELEGRAM_WEBHOOK_URL=https://your-host/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret

# Platform admin DB (org owner claims) — same cluster, different database
PLATFORM_MONGODB_DB=learnix_platform

# S3-compatible storage for speaking audio recordings
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=your-bucket-id
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Whisper speech-to-text microservice (learnix-whisper)
WHISPER_SERVICE_URL=http://127.0.0.1:5001
WHISPER_API_KEY=change_me_whisper_api_key
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_MS=120000
