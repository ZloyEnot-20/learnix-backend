# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ielts

# JWT — use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed CORS origins (the frontend URL)
CORS_ORIGINS=http://localhost:3000

# Seed: password used for the demo accounts created by `npm run seed`
SEED_ADMIN_PASSWORD=admin123
SEED_TEACHER_PASSWORD=teacher123
SEED_STUDENT_PASSWORD=student123
