{
  "name": "ielts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API + MongoDB backend for the IELTS / Learnix platform",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "pm2 start ecosystem.config.cjs --no-daemon --watch",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:speaking": "node src/seed/speaking-seed.js",
    "seed:reading": "node src/seed/ielts-reading-seed.js",
    "bot": "node src/bot/telegram-bot.js",
    "bot:webhook": "node src/scripts/register-telegram-webhook.js",
    "prod": "node scripts/pm2-prod.mjs start",
    "prod:stop": "node scripts/pm2-prod.mjs stop",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "db:check": "node scripts/check-mongodb.js",
    "bot:check": "node scripts/check-bot.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  }
}
